# Production настройки для Timeweb
DEBUG=False

# PostgreSQL база данных Timeweb
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Замените на данные вашей БД из панели Timeweb:
# DATABASE_URL=postgresql://gen_user:ваш_пароль@ваш_хост:5432/ваша_бд

# Безопасность
SECRET_KEY=your_super_secret_key_here_generate_new_one

# Хост настройки
ALLOWED_HOSTS=ваш_домен.ru,ваш_ip_адрес
CORS_ORIGINS=https://ваш_домен.ru,http://ваш_ip_адрес

# Логирование
LOG_LEVEL=INFO
